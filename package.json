{
  "name": "@noonat/intersect",
  "version": "0.1.0",
  "description": "Example code for simple collision detection",
  "keywords": [
    "collision",
    "collision-detection",
    "intersection",
    "aabb",
    "sweep",
    "2d",
    "games"
  ],
  "license": "Zlib",
  "homepage": "https://github.com/noonat/intersect",
  "repository": {
    "type": "git",
    "url": "https://github.com/noonat/intersect.git"
  },
  "scripts": {
    "build": "node build.js",
    "clean": "rimraf src/intersect.ts lib/intersect.js* docs/bundle.js* docs/bundle.css* docs/*.ttf docs/*.woff docs/*.woff2",
    "prepare": "npm run build",
    "test": "jest && eslint src test"
  },
  "main": "lib/intersect.js",
  "types": "lib/intersect.d.ts",
  "files": [
    "lib",
    "src/intersect.ts",
    "src/intersect.ts.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.2",
    "docco": "^0.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "markdown-it": "^15.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.66.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx"
    ],
    "transform": {
      "\\.(ts|tsx)$": "ts-jest"
    },
    "testRegex": "/test/.*\\.(ts|tsx|js|jsx)$"
  },
  "dependencies": {
    "katex": "^0.18.1"
  }
}
